# Токен Discord-бота (Developer Portal -> Bot -> Reset Token). НИКОГДА не коммитьте реальные значения.
DISCORD_BOT_TOKEN=

# Включить, если в Developer Portal включён Message Content Intent
# VP_MESSAGE_CONTENT_INTENT=true

# Куда писать SQLite (на bothost — путь постоянного диска/Volume) и где лежит config.json
# DATA_DIR=/app/data
# CONFIG_PATH=./config.json

# Прокси для Discord, если нужен
# DISCORD_PROXY=socks5://127.0.0.1:10808

# --- Опционально: интеграция с VDV (розыск). ---
# Без обеих переменных эта функция полностью отключена.
# BACKEND_PUBLIC_URL=
# VP_DISCORD_BOT_SECRET=
